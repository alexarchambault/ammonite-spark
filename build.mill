object core extends Cross[Core](Versions.scala)
trait Core  extends CrossScalaModule with WithPropertyFile with AmmSparkPublishModule
    with AmmSparkMima {
  def artifactName = "ammonite-spark"
  // The AmmoniteSparkSessionBuilder is version-specific: the Spark <= 3 variant lives in
  // src-spark3 and extends org.apache.spark.sql.SparkSession.Builder; the Spark 4 variant
  // (src-spark4, used by the core-spark4 module) extends the classic builder instead. Everything
  // else is shared in src.
  def sources = Task.Sources(
    BuildCtx.workspaceRoot / "modules" / "core" / "src",
    BuildCtx.workspaceRoot / "modules" / "core" / "src-spark3"
  )
  def compileMvnDeps = super.compileMvnDeps() ++ Seq(
    Deps.ammoniteReplApi,
    Deps.sparkSql(scalaVersion())
  )
  def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.classPathUtil,
    Deps.jettyServer
  )
  def propertyFilePath =
    os.sub / "org/apache/spark/sql/ammonitesparkinternals/ammonite-spark.properties"
  def versionInProperties = publishVersion()

  def mimaPreviousVersions = Task {
    val needs =
      if (scalaVersion().startsWith("2.12.")) "v0.9.0"
      else "v0.13.0"
    os.proc("git", "tag", "--merged", "HEAD^", "--contains", needs)
      .call()
      .out.lines()
      .map(_.trim)
      .filter(_.startsWith("v"))
      .map(_.stripPrefix("v"))
  }
}

// Spark 4 lives in its own module (rather than the Scala-version cross of `core`) because it must
// compile against a different, source-incompatible SparkSession builder API and is Scala-2.13-only.
// It reuses core's shared sources plus the Spark-4-specific builder in src-spark4, and is published
// under a distinct artifact so it can coexist with the Spark <= 3 `ammonite-spark`.
object `core-spark4` extends ScalaModule with WithPropertyFile with AmmSparkPublishModule
    with Spark4Jvm {
  def scalaVersion = Versions.scala213Spark4
  def artifactName = "ammonite-spark-spark4"
  def sources = Task.Sources(
    BuildCtx.workspaceRoot / "modules" / "core" / "src",
    BuildCtx.workspaceRoot / "modules" / "core" / "src-spark4"
  )
  def compileMvnDeps = super.compileMvnDeps() ++ Seq(
    Deps.ammoniteReplApiSpark4,
    Deps.sparkSql4
  )
  def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.classPathUtil,
    Deps.jettyServer
  )
  def propertyFilePath =
    os.sub / "org/apache/spark/sql/ammonitesparkinternals/ammonite-spark.properties"
  def versionInProperties = publishVersion()
}

