// Gather the publishLocalTestRepo of every module into a single local Maven
// repository, so tests can resolve the just-built artifacts without polluting
// ~/.ivy2/local via publishLocal.
def testRepo: T[PathRef] = {

  // Spark <= 3 modules. Deliberately does NOT include the Spark-4 modules, so a Spark <= 3 test
  // build never has to build (and resolve) them — they need Java 17 and a Spark 4 / Ammonite 3.0.8
  // toolchain. The Spark-4 modules live in testRepoSpark4 below.
  val publishModules: Seq[AmmSparkPublishModule] =
    Seq(`spark-stubs_24`, `spark-stubs_30`) ++
      `spark-stubs_32`.crossModules ++
      core.crossModules ++
      `almond-spark`.crossModules ++
      `almond-toree-spark`.crossModules

  Task {
    val repoDirs = Task.traverse(publishModules)(_.publishLocalTestRepo)()
    val dest     = Task.dest / "repo"
    for (repo <- repoDirs)
      os.copy(repo.path, dest, mergeFolders = true, replaceExisting = true, createFolders = true)
    PathRef(dest)
  }
}

// The Spark-4 (Scala-2.13-only) artifacts, kept separate from testRepo so the two test tracks are
// decoupled: the Spark-4 test modules resolve from here, the Spark <= 3 ones from testRepo.
def testRepoSpark4: T[PathRef] = {
  val publishModules: Seq[AmmSparkPublishModule] =
    Seq(`core-spark4`, `almond-spark-spark4`, `almond-toree-spark-spark4`)

  Task {
    val repoDirs = Task.traverse(publishModules)(_.publishLocalTestRepo)()
    val dest     = Task.dest / "repo"
    for (repo <- repoDirs)
      os.copy(repo.path, dest, mergeFolders = true, replaceExisting = true, createFolders = true)
    PathRef(dest)
  }
}

object `spark-distribution` extends Cross[SparkDistributionModule](SparkVersions.sparkDistributions)
trait SparkDistributionModule extends Cross.Module[SparkDistribution] {

  def sparkVersion = crossValue.sparkVersion

  def scalaVersion = Task {
    sparkDistributionScalaVersions(crossValue)
  }

  // Spark's own REPL jar is dropped from the distribution below, in favour of our stubs.
  // Which ones to use depends on the Spark version, like SparkDependencies.stubsDependency
  // does when ammonite-spark pulls the stubs at runtime - each of them is written against
  // the xbean-asm version that its Spark versions ship.
  private def stubsModule: ScalaModule =
    if (Version(sparkVersion) < Version("3.0.0")) `spark-stubs_24`
    else if (Version(sparkVersion) < Version("3.2.0")) `spark-stubs_30`
    else {
      val sbv = JvmWorkerUtil.scalaBinaryVersion(sparkDistributionScalaVersions(crossValue))
      val sv = Versions.scala
        .find(JvmWorkerUtil.scalaBinaryVersion(_) == sbv)
        .getOrElse(
          sys.error(s"No Scala $sbv version to build spark-stubs_32 for Spark $sparkVersion with")
        )
      `spark-stubs_32`(sv)
    }

  def sparkHome = Task {
    val sparkDir = SparkHome.createDistributionUnder(
      Task.dest,
      sparkVersion,
      crossValue.hadoopVersion,
      extraJars = Seq(stubsModule.jar().path)
    )

    PathRef(sparkDir)
  }

  def testEnv: T[Map[String, String]] = Task {
    Map(
      "SPARK_HOME"    -> sparkHome().path.toString,
      "SPARK_VERSION" -> sparkVersion
    )
  }
}

object `standalone-cluster` extends Cross[StandaloneClusterModule](SparkVersions.sparkDistributions)
trait StandaloneClusterModule extends StandaloneCluster with Cross.Module[SparkDistribution] {

  def sparkDistribution: SparkDistributionModule = `spark-distribution`(crossValue)

  private def jvmId = crossValue.jvmId

  def javaHome = Task {
    val fileCache = coursier.cache.FileCache()
    val jvmCache = coursier.jvm.JvmCache()
      .withArchiveCache(coursier.cache.ArchiveCache().withCache(fileCache))
      .withDefaultIndex
    val javaHome = coursier.jvm.JavaHome().withCache(jvmCache)
    val home     = javaHome.get(jvmId).unsafeRun()(using fileCache.ec)
    PathRef(os.Path(home.getAbsoluteFile))
  }

  def scalaVersion = sparkDistribution.scalaVersion

  def sparkHome = sparkDistribution.sparkHome
  def extraEnv = Task {
    val javaHome0 = javaHome().path
    Map(
      "JAVA_HOME" -> javaHome0.toString,
      "PATH" -> s"${javaHome0 / "bin"}${java.io.File.pathSeparator}${sys.env.getOrElse("PATH", "")}"
    )
  }

  def testEnv: T[Map[String, String]] = Task {
    // Bring up the standalone master and worker before running the tests.
    sparkSlave()
    Map(
      "SPARK_HOME"               -> sparkHome().path.toString,
      "STANDALONE_SPARK_MASTER"  -> sparkMaster().master,
      "STANDALONE_SPARK_VERSION" -> sparkDistribution.sparkVersion
    )
  }
}

trait AmmSparkTests extends TestModule {
  def testFramework = "utest.runner.Framework"
  def forkArgs = Task {
    super.forkArgs() ++
      Seq("-Xmx3g", "-Dfoo=bzz") ++
      // Spark accesses JDK internals that the module system locks down since Java 9, so
      // it needs these --add-opens to run on Java 11+ (Spark itself only started passing
      // them automatically in 3.3).
      Seq(
        "-XX:+IgnoreUnrecognizedVMOptions",
        "--add-opens=java.base/java.lang=ALL-UNNAMED",
        "--add-opens=java.base/java.lang.invoke=ALL-UNNAMED",
        "--add-opens=java.base/java.lang.reflect=ALL-UNNAMED",
        "--add-opens=java.base/java.io=ALL-UNNAMED",
        "--add-opens=java.base/java.net=ALL-UNNAMED",
        "--add-opens=java.base/java.nio=ALL-UNNAMED",
        "--add-opens=java.base/java.util=ALL-UNNAMED",
        "--add-opens=java.base/java.util.concurrent=ALL-UNNAMED",
        "--add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED",
        "--add-opens=java.base/jdk.internal.ref=ALL-UNNAMED",
        "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED",
        "--add-opens=java.base/sun.nio.cs=ALL-UNNAMED",
        "--add-opens=java.base/sun.security.action=ALL-UNNAMED",
        "--add-opens=java.base/sun.util.calendar=ALL-UNNAMED",
        "--add-opens=java.security.jgss/sun.security.krb5=ALL-UNNAMED"
      )
  }
  // The local Maven repo the embedded Ammonite REPL resolves the just-built artifacts from.
  // Spark <= 3 modules use testRepo; the Spark-4 modules override this with testRepoSpark4, so
  // neither test track pulls in the other's modules.
  def testArtifactsRepo: T[PathRef] = Task(testRepo())
  def forkEnv = super.forkEnv() ++ Seq(
    "COURSIER_REPOSITORIES" -> {
      val repoUrl = testArtifactsRepo().path.toNIO.toUri.toASCIIString
      s"$repoUrl|central"
    }
  )
}

// Shared test config for the Spark-4 test modules (local + yarn): resolve the just-built artifacts
// from testRepoSpark4, and pass the Spark-4 JVM options beyond the shared --add-opens set.
// `--add-modules=jdk.incubator.vector` can't go in the shared AmmSparkTests set because it doesn't
// exist before Java 16 and would break the Java-11 Spark <= 3 forks;
// `-Djdk.reflect.useDirectMethodHandle=false` keeps reflection-driven REPL output identical across
// Java 17/21.
trait Spark4Tests extends AmmSparkTests {
  def testArtifactsRepo = Task(testRepoSpark4())
  // Spark version the tests resolve at runtime, via the same AMMSPARK_SPARK_VERSION contract the
  // Spark <= 3 test modules use (read by ammonite.spark.Versions). Unlike those, the Spark version
  // is not a cross value here - the cross is over the JDK - so it comes from a Task.Input, which is
  // re-read on every run: that is how the 4.0.0-compiled artifacts get exercised against a 4.1.x /
  // 4.2.x runtime without touching the build.
  def spark4TestSparkVersion = Task.Input {
    sys.env.getOrElse("AMMSPARK_SPARK_VERSION", Versions.spark4Test)
  }
  def forkEnv = super.forkEnv() ++ Seq(
    "AMMSPARK_SPARK_VERSION" -> spark4TestSparkVersion()
  )
  def forkArgs = super.forkArgs() ++ Seq(
    "--add-modules=jdk.incubator.vector",
    "-Djdk.reflect.useDirectMethodHandle=false",
    "-Dio.netty.tryReflectionSetAccessible=true",
    // No-op on Spark 4.0 (and on Java 17/21), but part of Spark 4.1+'s DEFAULT_MODULE_OPTIONS:
    // it silences native-access warnings when exercising the artifacts against a 4.1.x / 4.2.x
    // runtime (via AMMSPARK_SPARK_VERSION).
    "--enable-native-access=ALL-UNNAMED"
  )
}

// Spark 3.x doesn't officially support Java 17 (only 8/11), so run the modules
// hosting Spark tests - and their forked tests, which inherit javaHome from their
// enclosing module - on Java 11. The Mill build itself runs on Java 17, and Mill 1
// can't fork tests on Java 8 (its test bootstrap relies on java.lang.ProcessHandle).
trait SparkTestsJvm extends JavaModule {

  def sparkJvmId: String
  private lazy val isJava8: Boolean =
    sparkJvmId.split(":").last.split('.').head.startsWith("8")

  // Mill 1 can't fork tests on Java 8 (its test bootstrap relies on java.lang.ProcessHandle),
  // so we fall back to Java 11, but pass --release 8 to javac
  def jvmId = s"temurin:${if (isJava8) "11" else sparkJvmId}"
  def javacOptions =
    if (isJava8)
      Task {
        super.javacOptions() ++ Seq("--release", "8")
      }
    else
      super.javacOptions
}

// Spark 4 supports Java 17/21 (not 8/11, nor the newer JVM Mill may itself run on), so its module
// and tests are pinned to Java 17.
trait Spark4Jvm extends JavaModule {
  def jvmId = "temurin:17"
}

lazy val sparkDistributionScalaVersions = SparkVersions.sparkDistributions
  .map(d => d -> SparkHome.scalaVersionFromSparkDistribVersion(d.sparkVersion, d.hadoopVersion))
  .toMap

lazy val allScalaVersions = (Versions.scala ++ sparkDistributionScalaVersions.values).distinct

object `test-definitions` extends Cross[TestDefinitions](allScalaVersions)
