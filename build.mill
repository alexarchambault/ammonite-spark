  def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.ammoniteCompilerSpark4.exclude(("com.google.guava", "guava")),
    Deps.ammoniteReplSpark4.exclude(("com.google.guava", "guava")),
    Deps.slf4jLog4j12,
    Deps.utest
  )
}

lazy val sparkMavenValues: Seq[SparkMaven] = {
  val first213SparkVersion = Version("3.2.0")
  for {
    sv       <- Versions.scala
    sparkVer <- SparkVersions.sparkMavenVersions
    value = SparkMaven(sparkVer, sv, "8")
    if Version(value.sparkVersion) >= first213SparkVersion || value.scalaVersion.startsWith("2.12.")
  } yield value
}

object `local-tests` extends Cross[LocalTests](sparkMavenValues)
trait LocalTests     extends ScalaModule with Cross.Module[SparkMaven] with WithPropertyFile
    with WithDependencyResourceFile
    with SparkTestsJvm with AmmSparkTests {

  private def sv = crossValue.scalaVersion
  def sparkJvmId = crossValue.jvmId

  def scalaVersion = sv

  def propertyFilePath       = os.sub / "ammonite/ammonite-spark.properties"
  def versionInProperties    = core(sv).publishVersion()
  def dependencyResourcePath = os.sub / "ammonite/spark/amm-test-dependencies.txt"

  def moduleDeps = Seq(
    `test-definitions`(sv)
  )

  def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.ammoniteCompiler.exclude(("com.google.guava", "guava")),
    Deps.ammoniteRepl.exclude(("com.google.guava", "guava")),
    Deps.slf4jLog4j12,
    Deps.utest
  )

  def forkEnv = super.forkEnv() ++ Seq(
    "AMMSPARK_SPARK_VERSION" -> crossValue.sparkVersion
  )
}

// Runs the shared test-definitions against Spark 4 with a local[*] master, on Java 17 and 21
// (Spark 4 supports both). The Spark version itself comes from Spark4Tests (AMMSPARK_SPARK_VERSION,
// defaulting to Versions.spark4Test) rather than from a cross value, so the cross stays 1-D.
val spark4TestJvmIds = Seq("17", "21")

object `local-tests-spark4` extends Cross[LocalTestsSpark4](spark4TestJvmIds)
trait LocalTestsSpark4      extends ScalaModule with WithPropertyFile
    with WithDependencyResourceFile with Spark4Tests with Cross.Module[String] {
  // crossValue is the JDK major to run the tests on (17 or 21).
  def jvmId                  = s"temurin:$crossValue"
  def scalaVersion           = Versions.scala213Spark4
  def propertyFilePath       = os.sub / "ammonite/ammonite-spark.properties"
  def versionInProperties    = `core-spark4`.publishVersion()
  def dependencyResourcePath = os.sub / "ammonite/spark/amm-test-dependencies.txt"

  def moduleDeps = Seq(
    `test-definitions-spark4`
  )

  def mvnDeps = super.mvnDeps() ++ Seq(
    Deps.ammoniteCompilerSpark4.exclude(("com.google.guava", "guava")),
    Deps.ammoniteReplSpark4.exclude(("com.google.guava", "guava")),
    Deps.slf4jLog4j12,
    Deps.utest
  )
}

// Spark-4 counterpart of yarn-tests. Like the Spark 3.2 YARN cross values, the actual YARN test is
// disabled (Yarn40Tests is an empty stub with the real test commented out) until the dockerized YARN
// cluster is upgraded from hadoop-2.7 to hadoop 3 — Spark >= 3.2, and hence Spark 4, need hadoop 3.
// The module is otherwise fully wired, so enabling it is just uncommenting Yarn40Tests.
object `yarn-tests-spark4` extends ScalaModule with Spark4Jvm with Spark4Tests
    with RunClasspathAsJars {
  def scalaVersion = Versions.scala213Spark4
  def moduleDeps = Seq(
    `test-definitions-spark4`
  )
}

object `local-spark-distrib-tests`
    extends Cross[LocalSparkDistribTests](SparkVersions.sparkDistributions)
trait LocalSparkDistribTests extends ScalaModule with SparkTestsJvm with AmmSparkTests
    with Cross.Module[SparkDistribution] {
  def sparkDistribution = `spark-distribution`(crossValue)
  def sparkJvmId        = crossValue.jvmId
  def scalaVersion      = sparkDistribution.scalaVersion
  def moduleDeps = Seq(
    `test-definitions`(sparkDistributionScalaVersions(crossValue))
  )

  def forkEnv = super.forkEnv() ++ sparkDistribution.testEnv()
}

object `standalone-tests` extends Cross[StandaloneTests](SparkVersions.sparkDistributions)
trait StandaloneTests     extends ScalaModule with SparkTestsJvm with AmmSparkTests
    with Cross.Module[SparkDistribution] {
  private val cluster = `standalone-cluster`(crossValue)
  def sparkJvmId      = crossValue.jvmId
  def scalaVersion    = cluster.scalaVersion
  def moduleDeps = Seq(
    `test-definitions`(sparkDistributionScalaVersions(crossValue))
  )
  def forkEnv = Task {
    super.forkEnv() ++ cluster.testEnv()
  }
}

object `yarn-tests` extends Cross[YarnTests](
      sparkMavenValues
        // Temporarily disabled, until we can (either or both)
        // - enable the hadoop-2.7 profile (and excluding the remaining hadoop 3 dependencies?) when fetching Spark dependencies
        // - update the docker-based hadoop setup in the tests to hadoop 3
        .filter(!_.sparkVersion.startsWith("3.2."))
    )
trait YarnTests extends ScalaModule with Cross.Module[SparkMaven] with SparkTestsJvm
    with AmmSparkTests
    with RunClasspathAsJars {

  private def sv = crossValue.scalaVersion

  def scalaVersion = sv

  def sparkJvmId = crossValue.jvmId

  def moduleDeps = Seq(
    `test-definitions`(sv)
  )

  def forkEnv = super.forkEnv() ++ Seq(
    "AMMSPARK_SPARK_VERSION" -> crossValue.sparkVersion
  )
}

object `yarn-spark-distrib-tests`
    extends Cross[YarnSparkDistribTests](SparkVersions.sparkDistributions)
trait YarnSparkDistribTests extends ScalaModule with SparkTestsJvm with AmmSparkTests
    with RunClasspathAsJars with Cross.Module[SparkDistribution] {
  def sparkDistribution = `spark-distribution`(crossValue)
  def scalaVersion      = sparkDistribution.scalaVersion
  def sparkJvmId        = crossValue.jvmId
  def moduleDeps = Seq(
    `test-definitions`(sparkDistributionScalaVersions(crossValue))
  )
  def forkEnv = super.forkEnv() ++ sparkDistribution.testEnv()
}
